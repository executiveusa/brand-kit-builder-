# PARÉ owner runtime — copy to an untracked secret store/runtime environment.
# Never commit real values.

# Required for authenticated API access.
PARE_API_TOKEN=replace-at-runtime

# Bind/port for compose. Keep loopback when terminating TLS through Caddy/Traefik/Coolify.
PARE_BIND_ADDRESS=127.0.0.1
PARE_PORT=8788

# Optional Darya/OpenHands worker endpoint.
DARYA_WORKER_URL=
DARYA_WORKER_TOKEN=

# Optional Postiz self-host/public API endpoint.
POSTIZ_BASE_URL=
POSTIZ_API_KEY=
