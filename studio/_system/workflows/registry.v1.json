      "steps": [
        {"step_id":"package","parent_stage":"40_deliver","action":"build-install-package","approval_required":false},
        {"step_id":"preflight","parent_stage":"30_validate","action":"verify-self-host-preflight","approval_required":false},
        {"step_id":"install","parent_stage":"50_publish","action":"install-on-owner-runtime","approval_required":true},
        {"step_id":"verify","parent_stage":"50_publish","action":"verify-owner-runtime","approval_required":false}
      ],
      "quality_floor": 8.5
    },
    {
      "workflow_id": "product-audit.v1",
      "name": "Home/product audit",
      "description": "Proof-driven audit of the PARÉ home/product surface after implementation.",
      "parent_stages": ["30_validate"],
      "steps": [
        {"step_id":"clarity","parent_stage":"30_validate","action":"audit-product-clarity","approval_required":false},
        {"step_id":"brand","parent_stage":"30_validate","action":"audit-brand-distinction","approval_required":false},
        {"step_id":"ux","parent_stage":"30_validate","action":"audit-krug-accessibility-mobile","approval_required":false},
        {"step_id":"truth","parent_stage":"30_validate","action":"audit-capability-truth","approval_required":false},
        {"step_id":"commercial","parent_stage":"30_validate","action":"audit-commercial-positioning","approval_required":false},
        {"step_id":"report","parent_stage":"30_validate","action":"write-audit-html","approval_required":false}
      ],
      "quality_floor": 8.5
    }
  ]
}
