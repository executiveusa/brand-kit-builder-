{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pauli.studio/schemas/creative-direction.v1.json",
  "title": "PARÉ Creative Direction v1",
  "type": "object",
  "required": ["version", "governing_idea", "distinctiveness", "brand_behavior", "stress_test", "commercial_desirability", "provenance"],
  "properties": {
    "version": { "const": "1.0.0" },
    "governing_idea": {
      "type": "object",
      "required": ["statement", "tension", "audience_truth", "cultural_truth", "business_truth", "must_feel", "must_not_feel", "score"],
      "properties": {
        "statement": {"type":"string","minLength":1},
        "tension": {"type":"string","minLength":1},
        "audience_truth": {"type":"string","minLength":1},
        "cultural_truth": {"type":"string","minLength":1},
        "business_truth": {"type":"string","minLength":1},
        "must_feel": {"type":"array","minItems":1,"items":{"type":"string"}},
        "must_not_feel": {"type":"array","minItems":1,"items":{"type":"string"}},
        "proof": {"type":"array","items":{"type":"string"}},
        "score": {"type":"number","minimum":0,"maximum":10}
      }
    },
    "distinctiveness": {
      "type": "object",
      "required": ["verdict", "score", "logo_removed_recognizable", "competitor_could_use_unchanged", "trend_dependent", "ownable", "memorable_behavior"],
      "properties": {
        "verdict": {"enum":["OWNABLE","DERIVATIVE","GENERIC","TREND_DEPENDENT","CATEGORY_COPY"]},
        "score": {"type":"number","minimum":0,"maximum":10},
        "logo_removed_recognizable": {"type":"boolean"},
        "competitor_could_use_unchanged": {"type":"boolean"},
        "trend_dependent": {"type":"boolean"},
        "ownable": {"type":"boolean"},
        "memorable_behavior": {"type":"string","minLength":1},
        "evidence": {"type":"array","items":{"type":"string"}}
      }
    },
    "brand_behavior": {
      "type": "object",
      "required": ["motion", "layout", "typography", "imagery", "ui", "expression_controls", "system_coherence_score"],
      "properties": {
        "motion": {"$ref":"#/$defs/behaviorRuleSet"},
        "layout": {"$ref":"#/$defs/behaviorRuleSet"},
        "typography": {"$ref":"#/$defs/behaviorRuleSet"},
        "imagery": {"$ref":"#/$defs/behaviorRuleSet"},
        "ui": {"$ref":"#/$defs/behaviorRuleSet"},
        "expression_controls": {"$ref":"#/$defs/behaviorRuleSet"},
        "system_coherence_score": {"type":"number","minimum":0,"maximum":10}
      }
    },
    "stress_test": {
      "type": "object",
      "required": ["surfaces", "recognizable_across_surfaces", "responsive_score"],
      "properties": {
        "surfaces": {
          "type":"array","minItems":6,
          "items": {
            "type":"object",
            "required":["name","status"],
            "properties": {
              "name":{"type":"string"},
              "status":{"enum":["pass","fail","not_applicable"]},
              "reason":{"type":"string"},
              "proof_pointer":{"type":"string"}
            }
          }
        },
        "recognizable_across_surfaces":{"type":"boolean"},
        "responsive_score":{"type":"number","minimum":0,"maximum":10}
      }
    },
    "commercial_desirability": {
      "type": "object",
      "required": ["perceived_value", "offer_comprehension", "price_position_fit", "desire", "reason_to_choose", "market_position", "next_action_coherence", "score"],
      "properties": {
        "perceived_value":{"type":"number","minimum":0,"maximum":10},
        "offer_comprehension":{"type":"number","minimum":0,"maximum":10},
        "price_position_fit":{"type":"number","minimum":0,"maximum":10},
        "desire":{"type":"number","minimum":0,"maximum":10},
        "reason_to_choose":{"type":"number","minimum":0,"maximum":10},
        "market_position":{"type":"number","minimum":0,"maximum":10},
        "next_action_coherence":{"type":"number","minimum":0,"maximum":10},
        "score":{"type":"number","minimum":0,"maximum":10},
        "evidence":{"type":"array","items":{"type":"string"}}
      }
    },
    "provenance": {
      "type":"object",
      "required":["created_by","created_at"],
      "properties": {
        "created_by":{"type":"string"},
        "created_at":{"type":"string","format":"date-time"},
        "approved_by":{"type":"string"},
        "approved_at":{"type":"string","format":"date-time"},
        "sources":{"type":"array","items":{"type":"string"}}
      }
    }
  },
  "$defs": {
    "behaviorRuleSet": {
      "type":"array","minItems":1,
      "items": {
        "type":"object",
        "required":["rule","why","use_when","avoid_when"],
        "properties": {
          "rule":{"type":"string","minLength":1},
          "why":{"type":"string","minLength":1},
          "use_when":{"type":"array","minItems":1,"items":{"type":"string"}},
          "avoid_when":{"type":"array","minItems":1,"items":{"type":"string"}}
        }
      }
    }
  },
  "allOf": [
    {"properties":{"governing_idea":{"properties":{"score":{"minimum":9}}}}},
    {"properties":{"distinctiveness":{"properties":{"verdict":{"const":"OWNABLE"},"score":{"minimum":9},"competitor_could_use_unchanged":{"const":false},"trend_dependent":{"const":false},"ownable":{"const":true}}}}},
    {"properties":{"brand_behavior":{"properties":{"system_coherence_score":{"minimum":9}}}}},
    {"properties":{"stress_test":{"properties":{"recognizable_across_surfaces":{"const":true},"responsive_score":{"minimum":9}}}}},
    {"properties":{"commercial_desirability":{"properties":{"score":{"minimum":9}}}}}
  ]
}
