{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pauli.studio/schemas/work-order.v2.json",
  "title": "PARÉ Work Order v2",
  "description": "Transport-neutral, workflow-aware durable unit of work for One Hands. Provider/session/secrets are intentionally excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "work_order_id",
    "workflow_id",
    "parent_stage",
    "step_id",
    "action",
    "tenant",
    "project",
    "outcome",
    "state",
    "inputs",
    "requested_outputs",
    "approval",
    "idempotency_key",
    "created_at"
  ],
  "properties": {
    "version": { "const": "work-order.v2" },
    "work_order_id": { "type": "string", "pattern": "^WO-[0-9]{8}-[0-9]{4}$" },
    "workflow_id": { "type": "string", "pattern": "^[a-z0-9-]+\\.v[0-9]+$" },
    "parent_stage": { "enum": ["00_intake", "10_strategy", "20_design", "30_validate", "40_deliver", "50_publish"] },
    "step_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "action": { "type": "string", "minLength": 1, "maxLength": 128 },
    "tenant": { "type": "string", "minLength": 1 },
    "project": { "type": "string", "minLength": 1 },
    "outcome": { "type": "string", "minLength": 1 },
    "state": {
      "enum": ["queued", "running", "candidate", "gate_pending", "failed", "retrying", "escalated", "approved", "complete", "done"]
    },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 3, "default": 1 },
    "inputs": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "attachments": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "context_packet": { "type": "string" },
        "prior_handoffs": { "type": "array", "items": { "type": "string" } },
        "protected_items": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "constraints": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "hard_bans": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "requested_outputs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "media_type": { "type": "string" },
          "status": { "enum": ["draft", "candidate", "verified", "approved", "canonical", "official"] }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "status"],
      "properties": {
        "required": { "type": "boolean" },
        "status": { "enum": ["not_required", "pending", "approved", "rejected"] },
        "approved_by": { "type": "string" },
        "approved_at": { "type": "string", "format": "date-time" },
        "evidence_ref": { "type": "string" }
      }
    },
    "idempotency_key": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gate_id": { "enum": ["G0", "G1", "G2", "G3", "G4", "G5"] },
        "requires_human": { "type": "boolean" }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "ref"],
        "properties": {
          "kind": { "type": "string" },
          "ref": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" }
  }
}
